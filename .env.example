# Banco Railway/PostgreSQL
DATABASE_URL="${{Postgres.DATABASE_URL}}"

# Aplicação
APP_ORIGIN="https://cancelamento.evolutionacademia.com.br"
TRUSTED_ORIGINS="https://cancelamento.evolutionacademia.com.br,https://evolution-cancelamento-360-production.up.railway.app"
NEXT_PUBLIC_APP_NAME="Evolution Cancelamento 360"
NEXT_PUBLIC_DEMO_MODE="false"
SESSION_SECRET="gere-com-openssl-rand-base64-48"
PUBLIC_ID_PEPPER="gere-com-openssl-rand-base64-48"
EXTERNAL_ID_PEPPER="gere-com-openssl-rand-base64-48"
IDENTITY_CODE_PEPPER="gere-com-openssl-rand-base64-48"
APP_DATA_ENCRYPTION_KEY="gere-com-openssl-rand-base64-32"
IP_HASH_PEPPER="gere-com-openssl-rand-base64-48"

# Proprietário (Ruy) - único perfil com autorização final para cancelar no EVO
OWNER_NAME="Ruy"
OWNER_USERNAME="ruy"
OWNER_PASSWORD_HASH=""
# Obrigatório em produção: segredo Base32 no aplicativo autenticador do proprietário
OWNER_TOTP_SECRET=""
# Incremente este número para invalidar imediatamente todas as sessões atuais do proprietário
OWNER_SESSION_VERSION="1"

# EVO/W12 - backend apenas
EVO_INTEGRATION_MODE="read" # manual | read | write
EVO_WRITE_ENABLED="false"
EVO_API_BASE_URL="https://evo-integracao.w12app.com.br"
EVO_AUTH_MODE="basic"
EVO_TOKEN_HEADER="x-api-key"
EVO_REQUEST_TIMEOUT_MS="8000"
EVO_MONTHLY_REQUEST_SOFT_LIMIT="900"
EVO_MONTHLY_REQUEST_HARD_LIMIT="990"
EVO_ACTIVE_CONTRACT_STATUSES="ACTIVE,ATIVO,ATIVA,VIGENTE,OPEN,1"

# Credenciais por unidade. Cada token fica limitado à própria unidade.
EVO_CONDOR_API_USERNAME=""
EVO_CONDOR_API_TOKEN=""
EVO_UMARIZAL_API_USERNAME=""
EVO_UMARIZAL_API_TOKEN=""
# Compatibilidade/fallback: deixe vazios quando as duas credenciais por unidade estiverem configuradas.
EVO_API_USERNAME=""
EVO_API_TOKEN=""
EVO_UNIT_NAME="Evolution"

# Login público: CPF + nascimento -> /members/basic -> perfil completo -> OTP no e-mail do EVO
EVO_MEMBERS_PATH="/api/v1/members/basic"
EVO_MEMBER_CPF_QUERY_PARAM="document"
EVO_MEMBER_EMAIL_QUERY_PARAM="email"
EVO_ACTIVE_CLIENTS_PATH="/api/v1/members/{idMember}"
EVO_MEMBER_PROFILE_PATH="/api/v1/members/{idMember}"

# Contratos / cancelamento: confirmar paths exatos da conta antes de habilitar escrita
EVO_MEMBER_BY_ID_PATH=""
EVO_CONTRACTS_BY_MEMBER_PATH=""
EVO_CONTRACT_BY_ID_PATH=""
EVO_CANCEL_CONTRACT_PATH="/api/v1/membermembership/cancel-membermembership"
EVO_CANCEL_METHOD="POST"
EVO_CANCEL_ID_FIELD="idMemberMembership"
EVO_CANCEL_PROTOCOL_FIELD=""

# Forma de pagamento recorrente: manter desabilitado até homologar endpoint específico
EVO_REMOVE_PAYMENT_METHOD_ENABLED="false"
EVO_REMOVE_PAYMENT_METHOD_PATH=""
EVO_REMOVE_PAYMENT_METHOD_METHOD="DELETE"

# Webhook opcional - API Pro
EVO_WEBHOOK_AUTH_MODE="hmac"
EVO_WEBHOOK_SECRET=""
EVO_WEBHOOK_SIGNATURE_HEADER="x-evo-signature"
EVO_WEBHOOK_TIMESTAMP_HEADER="x-evo-timestamp"
EVO_WEBHOOK_MAX_SKEW_SECONDS="300"

# OTP do cliente. Com smtp.resend.com o backend usa a API HTTPS do Resend para evitar travas de socket SMTP.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER="resend"
SMTP_PASSWORD=""
# Opcional: se definido, tem prioridade sobre SMTP_PASSWORD para a API HTTPS do Resend
RESEND_API_KEY=""
SMTP_FROM="Evolution Academia <cancelamento@evolutionacademia.com.br>"
MAIL_REQUEST_TIMEOUT_MS="8000"
OTP_TTL_MINUTES="10"
OTP_MAX_ATTEMPTS="5"

# Pagamento da multa do plano anual recorrente
CANCELLATION_FEE_PIX_KEY=""
CANCELLATION_FEE_PIX_NAME="Evolution Academia"

# Regras operacionais
CUSTOMER_DIRECT_CANCELLATION="false"
DEFAULT_SLA_HOURS="48"
RATE_LIMIT_PUBLIC_PER_10_MIN="20"
RATE_LIMIT_ADMIN_LOGIN_PER_15_MIN="8"
