# Banco Railway/PostgreSQL
DATABASE_URL="${{Postgres.DATABASE_URL}}"

# Aplicação
APP_ORIGIN="https://cancelamento.seudominio.com.br"
NEXT_PUBLIC_APP_NAME="Evolution Cancelamento 360"
NEXT_PUBLIC_DEMO_MODE="false"
SESSION_SECRET="gere-com-openssl-rand-base64-48"
PUBLIC_ID_PEPPER="gere-com-openssl-rand-base64-48"
EXTERNAL_ID_PEPPER="gere-com-openssl-rand-base64-48"
OTP_PEPPER="gere-com-openssl-rand-base64-48"
APP_DATA_ENCRYPTION_KEY="gere-com-openssl-rand-base64-32"
IP_HASH_PEPPER="gere-com-openssl-rand-base64-48"

# Domínio e e-mail oficial
CANCELLATION_PUBLIC_URL="https://cancelamento.seudominio.com.br"
CANCELLATION_CONTACT_EMAIL="cancelamento@seudominio.com.br"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="cancelamento@seudominio.com.br"
SMTP_FROM_NAME="Evolution Academia | Cancelamentos"
SMTP_REPLY_TO="cancelamento@seudominio.com.br"
OTP_TTL_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_SECONDS="60"
LGPD_CONSENT_VERSION="EV-LGPD-CANCELAMENTO-2026.09-v1"

# Equipe / contingência inicial
# Ruy deve ser OWNER; os demais acessos podem ser revogados pelo OWNER dentro do 360.
ADMIN_1_NAME="Gerrard"
ADMIN_1_USERNAME="gerrard"
ADMIN_1_EMAIL="gerrard@seudominio.com.br"
ADMIN_1_PASSWORD_HASH=""
ADMIN_1_ROLE="ADMIN"
ADMIN_2_NAME="Ruy"
ADMIN_2_USERNAME="ruy"
ADMIN_2_EMAIL="ruy@seudominio.com.br"
ADMIN_2_PASSWORD_HASH=""
ADMIN_2_ROLE="OWNER"

# EVO/W12 - backend apenas
# Suporte EVO confirmou Basic Auth com DNS/usuário + token.
EVO_INTEGRATION_MODE="read" # manual | read | write
EVO_WRITE_ENABLED="false"
EVO_API_BASE_URL="https://evo-integracao.w12app.com.br"
EVO_API_TOKEN=""
EVO_API_USERNAME="" # DNS/usuário gerado no EVO
EVO_AUTH_MODE="basic"
EVO_TOKEN_HEADER="x-api-key"
EVO_REQUEST_TIMEOUT_MS="8000"
EVO_MONTHLY_REQUEST_SOFT_LIMIT="900"
EVO_MONTHLY_REQUEST_HARD_LIMIT="990"
EVO_ACTIVE_CONTRACT_STATUSES="ACTIVE,ATIVO,ATIVA,VIGENTE,OPEN,1"

# Paths EVO confirmados conceitualmente pelo suporte.
# Ajuste os query params conforme a documentação exibida na conta antes de produção.
EVO_MEMBER_BY_ID_PATH="/api/v1/members/{memberId}"
EVO_MEMBER_BY_CPF_PATH="/api/v1/members?cpf={cpf}"
EVO_CONTRACTS_BY_MEMBER_PATH="/api/v1/membermembership/get-summary-of-membermemberships-by-id?idMember={memberId}"
EVO_CONTRACT_BY_ID_PATH="/api/v1/membermembership/{contractId}"
EVO_INVOICES_BY_MEMBER_PATH=""
EVO_CANCEL_CONTRACT_PATH="/api/v1/membermembership/cancel-membermembership"
EVO_CANCEL_METHOD="POST"

# Remoção do cartão/forma de pagamento após cancelar plano recorrente.
# Só habilite após homologar o endpoint correto com o EVO.
EVO_REMOVE_PAYMENT_METHOD_ENABLED="false"
EVO_REMOVE_PAYMENT_METHOD_PATH=""
EVO_REMOVE_PAYMENT_METHOD_METHOD="DELETE"

# Webhook opcional - API Pro
EVO_WEBHOOK_AUTH_MODE="hmac"
EVO_WEBHOOK_SECRET=""
EVO_WEBHOOK_SIGNATURE_HEADER="x-evo-signature"
EVO_WEBHOOK_TIMESTAMP_HEADER="x-evo-timestamp"
EVO_WEBHOOK_MAX_SKEW_SECONDS="300"

# Pagamento da taxa recorrente antecipada
CANCELLATION_FEE_PIX_KEY=""
CANCELLATION_FEE_PIX_NAME="Evolution Academia"

# Regras operacionais
CUSTOMER_DIRECT_CANCELLATION="false"
DEFAULT_SLA_HOURS="48"
REFUND_DEADLINE_BUSINESS_DAYS="60"
RATE_LIMIT_PUBLIC_PER_10_MIN="20"
RATE_LIMIT_ADMIN_LOGIN_PER_15_MIN="8"
