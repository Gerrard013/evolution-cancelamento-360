# Banco Railway/PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/evolution360?schema=public"

# Aplicação
APP_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Evolution Cancelamento 360"
NEXT_PUBLIC_DEMO_MODE="true"
SESSION_SECRET="troque-por-64-bytes-aleatorios"
PUBLIC_ID_PEPPER="troque-por-outro-segredo-aleatorio"
EXTERNAL_ID_PEPPER="troque-por-outro-segredo-aleatorio"
APP_DATA_ENCRYPTION_KEY="base64-de-32-bytes"
IP_HASH_PEPPER="troque-por-outro-segredo"

# Login administrativo. Gere ADMIN_PASSWORD_HASH com: npm run admin:hash -- "SUA-SENHA-FORTE"
ADMIN_EMAIL="admin@empresa.com"
ADMIN_PASSWORD_HASH=""
# Opcional, mas recomendado em produção: segredo TOTP Base32 do autenticador
ADMIN_TOTP_SECRET=""

# EVO/W12 — SOMENTE backend. Nunca usar prefixo NEXT_PUBLIC_ nestas chaves.
EVO_INTEGRATION_MODE="manual" # manual | read | write
EVO_WRITE_ENABLED="false"
EVO_API_BASE_URL=""
EVO_API_TOKEN=""
EVO_API_USERNAME=""
EVO_AUTH_MODE="bearer" # bearer | basic | header
EVO_TOKEN_HEADER="x-api-key"
EVO_REQUEST_TIMEOUT_MS="8000"
EVO_MONTHLY_REQUEST_SOFT_LIMIT="900"
EVO_MONTHLY_REQUEST_HARD_LIMIT="990"

# Templates de endpoint conforme a documentação/homologação do EVO.
# Não há defaults de escrita para evitar cancelar contrato no endpoint errado.
EVO_MEMBER_BY_ID_PATH=""
EVO_CONTRACTS_BY_MEMBER_PATH=""
EVO_CONTRACT_BY_ID_PATH=""
EVO_CANCEL_CONTRACT_PATH=""

# Webhook EVO: configurar conforme o mecanismo suportado pelo fornecedor.
EVO_WEBHOOK_AUTH_MODE="hmac" # hmac | bearer
EVO_WEBHOOK_SECRET=""
EVO_WEBHOOK_SIGNATURE_HEADER="x-evo-signature"
EVO_WEBHOOK_TIMESTAMP_HEADER="x-evo-timestamp"
EVO_WEBHOOK_MAX_SKEW_SECONDS="300"

# Regras operacionais
CUSTOMER_DIRECT_CANCELLATION="false"
DEFAULT_SLA_HOURS="48"
RATE_LIMIT_PUBLIC_PER_10_MIN="20"
RATE_LIMIT_ADMIN_LOGIN_PER_15_MIN="8"
EVO_CANCEL_METHOD="DELETE" # DELETE | PUT, somente após confirmar no EVO
