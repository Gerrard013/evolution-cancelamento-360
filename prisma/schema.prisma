generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  DRAFT
  SENT
  AWAITING_SIGNATURE
  SIGNED_RECEIVED
  FEE_PENDING
  READY_TO_CANCEL
  UNDER_REVIEW
  APPROVED
  MANUAL_REVIEW
  EVO_CANCEL_REQUESTED
  EVO_CANCELLED
  CANCELLED_CONFIRMED
  REFUND_PENDING
  REFUND_REGISTERED
  COMPLETED
  REJECTED
  CANCELLED_BY_CUSTOMER
}

enum UserRole {
  OWNER
  ATTENDANCE
  ANALYST
  FINANCE
  MANAGER
  ADMIN
  AUDITOR
}

enum IdentityPurpose {
  CANCELLATION
  PROTOCOL_STATUS
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  username     String?  @unique
  passwordHash String?
  role         UserRole
  unit         String?
  active       Boolean  @default(true)
  permissions  Json?
  createdBy    String?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  events       AuditEvent[]
}

// PII necessária ao fluxo é pseudonimizada e cifrada em repouso.
// CPF/e-mail nunca são expostos em logs ou URLs.
model Customer {
  id                   String   @id @default(cuid())
  externalIdHash       String?  @unique
  externalIdCiphertext String?
  documentHash         String?  @unique
  documentCiphertext   String?
  emailHash            String?
  emailCiphertext      String?
  emailMask            String?
  displayName          String
  contactHint          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  contracts            Contract[]
  requests             CancellationRequest[]
  accessGrants         PublicAccessGrant[]
  identityChallenges   IdentityChallenge[]
}

model Contract {
  id                   String   @id @default(cuid())
  externalIdHash       String?  @unique
  externalIdCiphertext String?
  customerId           String
  unit                 String
  planName             String
  planType             String
  startDate            DateTime
  endDate              DateTime?
  amountPaid           Decimal  @db.Decimal(12, 2)
  recurring            Boolean  @default(false)
  status               String   @default("ACTIVE")
  metadata             Json?
  syncedAt             DateTime?
  customer             Customer @relation(fields: [customerId], references: [id])
  requests             CancellationRequest[]
  accessGrants         PublicAccessGrant[]

  @@index([customerId, status])
}

model IdentityChallenge {
  id                String          @id @default(cuid())
  purpose           IdentityPurpose @default(CANCELLATION)
  customerId        String
  cpfHash           String
  emailHash         String
  emailMask         String
  codeHash          String
  attempts          Int             @default(0)
  maxAttempts       Int             @default(5)
  expiresAt         DateTime
  verifiedAt        DateTime?
  consentAcceptedAt DateTime
  consentVersion    String
  lastSentAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())
  customer          Customer         @relation(fields: [customerId], references: [id])

  @@index([cpfHash, createdAt])
  @@index([customerId, createdAt])
  @@index([expiresAt])
}

// Modelo legado mantido apenas para compatibilidade de banco.
// A V7 desativou IDs públicos como mecanismo de autenticação.
model PublicAccessGrant {
  id          String   @id @default(cuid())
  codeHash    String   @unique
  customerId  String
  contractId  String
  active      Boolean  @default(true)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  createdBy   String?
  customer    Customer @relation(fields: [customerId], references: [id])
  contract    Contract @relation(fields: [contractId], references: [id])

  @@index([contractId, active])
}

model CancellationRequest {
  id                    String        @id @default(cuid())
  protocol              String        @unique
  activeKey             String?       @unique
  customerId            String
  contractId            String
  unit                  String
  reasonCode            String
  reasonDetails         String?       // legado; novas gravações usam reasonDetailsCiphertext
  reasonDetailsCiphertext String?
  desiredDate           DateTime
  status                RequestStatus @default(SENT)
  slaDueAt              DateTime?
  currentOwner          String?
  termVersion           String
  termAcceptedAt        DateTime
  termGeneratedAt       DateTime?
  signedTermReceivedAt  DateTime?
  submittedAt           DateTime?
  requesterAddress      String?       // legado; novas gravações usam requesterAddressCiphertext
  requesterAddressCiphertext String?
  rgCiphertext          String?
  cpfLast4              String?
  verifiedEmailMask     String?
  identityVerifiedAt    DateTime?
  identityMethod        String?       @default("EVO_EMAIL_OTP")
  lgpdConsentVersion    String?
  lgpdConsentAt         DateTime?
  sourceChannel         String        @default("OFFICIAL_PORTAL")
  contactEmail          String?
  pixKey                String?       // legado; novas gravações usam pixKeyCiphertext
  pixKeyCiphertext      String?
  cancellationFee       Decimal       @default(0) @db.Decimal(12, 2)
  cancellationFeePaidAt DateTime?
  refundDueAt           DateTime?
  paymentMethodRemovalStatus String?
  evoOperationId        String?
  evoLastErrorCode      String?
  evoLastAttemptAt      DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  customer              Customer      @relation(fields: [customerId], references: [id])
  contract              Contract      @relation(fields: [contractId], references: [id])
  calculations          RefundCalculation[]
  refund                Refund?
  attachments           Attachment[]
  events                AuditEvent[]

  @@index([unit, status])
  @@index([contractId, status])
  @@index([refundDueAt])
}

model CalculationRule {
  id            String   @id @default(cuid())
  version       String   @unique
  name          String
  percentage    Decimal? @db.Decimal(7, 4)
  fixedFee      Decimal? @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  criteria      Json
  active        Boolean  @default(false)
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  calculations  RefundCalculation[]
}

model RefundCalculation {
  id              String   @id @default(cuid())
  requestId       String
  ruleId          String
  eligibleBase    Decimal  @db.Decimal(12, 2)
  unusedBalance   Decimal  @db.Decimal(12, 2)
  deduction       Decimal  @db.Decimal(12, 2)
  priorRefunds    Decimal  @db.Decimal(12, 2)
  estimatedRefund Decimal  @db.Decimal(12, 2)
  memory          Json
  createdAt       DateTime @default(now())
  request         CancellationRequest @relation(fields: [requestId], references: [id])
  rule            CalculationRule @relation(fields: [ruleId], references: [id])
}

model Refund {
  id             String   @id @default(cuid())
  requestId      String   @unique
  approvedAmount Decimal  @db.Decimal(12, 2)
  executedAmount Decimal  @db.Decimal(12, 2)
  executedAt     DateTime
  method         String
  transactionRef String?
  receiptUrl     String?
  request        CancellationRequest @relation(fields: [requestId], references: [id])
}

// Upload público é limitado a documentos previstos pelo fluxo.
// Arquivos ficam em quarentena lógica e são validados antes de uso administrativo.
model Attachment {
  id            String   @id @default(cuid())
  requestId     String
  type          String
  originalName  String
  objectKey     String   @unique
  mimeType      String
  sizeBytes     Int
  sha256        String
  malwareStatus String   @default("QUARANTINED")
  content       Bytes?
  storageMode   String   @default("DATABASE")
  uploadedBy    String?
  createdAt     DateTime @default(now())
  request       CancellationRequest @relation(fields: [requestId], references: [id])
}

model AuditEvent {
  id            String   @id @default(cuid())
  requestId     String?
  userId        String?
  action        String
  entity        String
  entityId      String
  before        Json?
  after         Json?
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime @default(now())
  request       CancellationRequest? @relation(fields: [requestId], references: [id])
  user          User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

model EvoApiUsage {
  monthKey  String   @id
  hitCount  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model EvoCache {
  cacheKey  String   @id
  payload   Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model EvoWebhookEvent {
  eventIdHash String   @id
  eventType   String
  payloadHash String
  receivedAt  DateTime @default(now())
  processedAt DateTime?
}
